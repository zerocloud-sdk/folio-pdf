* text=auto

# Preserve PDF stream bytes and cross-reference offsets.
*.pdf binary

# Preserve exact T29 tool output and patch bytes referenced by evidence hashes.
capabilities/evidence/artifacts/T29-*.txt -text whitespace=-blank-at-eol,-blank-at-eof
capabilities/evidence/artifacts/T29-final-getter-javadoc.patch -text whitespace=-blank-at-eol,-blank-at-eof

# Preserve exact T30 evidence, including raw tool whitespace and recorded hashes.
capabilities/evidence/T30-*.md -text whitespace=-blank-at-eol,-blank-at-eof
capabilities/evidence/artifacts/T30-* -text whitespace=-blank-at-eol,-blank-at-eof
capabilities/evidence/T30-r2/** -text whitespace=-blank-at-eol,-blank-at-eof

# Preserve exact T70 raw tool output and recorded evidence hashes.
capabilities/evidence/T70-*/**/*.txt -text whitespace=-blank-at-eol,-blank-at-eof
capabilities/evidence/foundation/T70-*/**/*.txt -text whitespace=-blank-at-eol,-blank-at-eof

# Preserve exact T71 raw tool output and recorded evidence hashes.
capabilities/evidence/T71-*/**/*.txt -text whitespace=-blank-at-eol,-blank-at-eof
capabilities/evidence/foundation/T71-*/**/*.txt -text whitespace=-blank-at-eol,-blank-at-eof

# Preserve the reviewed checklist bytes bound by the final delivery receipt.
capabilities/evidence/T71-delivery/completion-checklist.md -text whitespace=-blank-at-eof

# Preserve exact T72 qualification, certification, and development output.
capabilities/evidence/T72-delivery/development/*.txt -text whitespace=-blank-at-eol,-blank-at-eof
capabilities/evidence/T72-standards-qualification/**/*.txt -text whitespace=-blank-at-eol,-blank-at-eof
capabilities/evidence/T72-source-visual-qualification/*.txt -text whitespace=-blank-at-eol,-blank-at-eof
capabilities/evidence/foundation/T72-*/**/*.txt -text whitespace=-blank-at-eol,-blank-at-eof

# Preserve exact T75 qualification, certification, and development output.
capabilities/evidence/T75-*/**/*.txt -text whitespace=-blank-at-eol,-blank-at-eof
capabilities/evidence/T75-*/**/*.log -text whitespace=-blank-at-eol,-blank-at-eof

# Preserve the pinned T13 patch's diff context and tab-separated model fields.
build-tools/acceptance/arlington/t13-r1.patch -text whitespace=-blank-at-eol

# Preserve the original standards reference fetched for the null interpretation.
capabilities/evidence/T75-delivery/standards-r11/null-interpretation-review/clause14.html -text whitespace=-blank-at-eol,-blank-at-eof

# These extraction values intentionally end with a mapped U+0020 character.
capabilities/profiles/T13-text/corpus.properties -text whitespace=-blank-at-eol
capabilities/evidence/T75-foundation-20260914-r4/text/*/observations/*-uncertain-geometry/*.properties -text whitespace=-blank-at-eol
capabilities/evidence/T75-foundation-20260914-r4/text/*/observations/*-uncertain-geometry/semantic/observation.properties -text whitespace=-blank-at-eol
capabilities/evidence/T75-foundation-20260914-r4/text/*/observations/negative/semantic/positive-uncertain-geometry/observation.properties -text whitespace=-blank-at-eol

*.sh text eol=lf
mvnw text eol=lf
*.cmd text eol=crlf
