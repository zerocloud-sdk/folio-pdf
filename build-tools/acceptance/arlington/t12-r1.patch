+// SPDX-License-Identifier: Apache-2.0
+// Original supplemental ISO 32000 graph predicates for the qualified T11 checker.
+// They inspect the independent SDK graph; they never call Folio or read expected products.
+#ifndef FOLIO_METADATA_CHECKS_H
+#define FOLIO_METADATA_CHECKS_H
+
+#include <cmath>
+#include <cctype>
+#include <algorithm>
+#include <memory>
+#include <ostream>
+#include <set>
+#include <string>
+#include "ArlingtonPDFShim.h"
+#ifdef ARL_PDFSDK_PDFIUM
+#include <expat.h>
+#endif
+
+namespace folio_metadata {
+using namespace ArlingtonPDFShim;
+using Owned = std::unique_ptr<ArlPDFObject>;
+
+inline bool kind(ArlPDFObject* object, PDFObjectType type) {
+    return object != nullptr && object->get_object_type() == type;
+}
+inline ArlPDFDictionary* dictionary(ArlPDFObject* object) {
+    return kind(object, PDFObjectType::ArlPDFObjTypeDictionary) ? static_cast<ArlPDFDictionary*>(object) : nullptr;
+}
+inline void error(std::ostream& output, const char* message) {
+    output << "Error: " << message << '\n';
+}
+inline double integer(ArlPDFObject* object) {
+    return kind(object, PDFObjectType::ArlPDFObjTypeNumber)
+            && static_cast<ArlPDFNumber*>(object)->is_integer_value()
+            ? static_cast<ArlPDFNumber*>(object)->get_value() : 0;
+}
+
+inline bool mime_token(wchar_t value) {
+    return value >= 0 && value < 128 && (std::isalnum(static_cast<unsigned char>(value))
+            || std::wstring(L"!#$%&'*+-.^_`|~").find(value) != std::wstring::npos);
+}
+
+inline bool mime_name(const std::wstring& value) {
+    // Annex E first-class names may instead use a registered four-character prefix.
+    if (value.size() > 5 && value[4] == L'_' && std::all_of(value.begin(), value.begin() + 4,
+            [](wchar_t ch) { return ch >= 0 && ch < 128 && std::isalnum(static_cast<unsigned char>(ch)); }))
+        return true;
+    auto slash = value.find(L'/');
+    return slash != std::wstring::npos && slash != 0 && slash + 1 < value.size()
+            && std::all_of(value.begin(), value.begin() + slash, mime_token)
+            && std::all_of(value.begin() + slash + 1, value.end(), mime_token);
+}
+
+inline void file_specification(ArlPDFDictionary* specification, std::ostream& output) {
+    Owned ef(specification->get_value(L"EF"));
+    Owned type(specification->get_value(L"Type"));
+    if (ef != nullptr && (type == nullptr || kind(type.get(), PDFObjectType::ArlPDFObjTypeNull)))
+        error(output, "file specification Type is required when EF is present");
+}
+
+#ifdef ARL_PDFSDK_PDFIUM
+inline void metadata_xml(ArlPDFStream* stream, std::ostream& output) {
+    auto decoded = stream->decoded_content();
+    // A bounded checker failure is unavailable evidence, never a syntax rejection.
+    if (decoded.bytes.size() > 64U * 1024U * 1024U) {
+        output << "Warning: metadata XML exceeds the checker decoded-byte bound\n";
+        return;
+    }
+    XML_Parser parser = XML_ParserCreateNS(nullptr, '\x1f');
+    if (parser == nullptr) {
+        output << "Warning: metadata XML parser is unavailable\n";
+        return;
+    }
+    // Expat has no external-resource reader. No entity-loading handler is installed.
+    XML_SetParamEntityParsing(parser, XML_PARAM_ENTITY_PARSING_NEVER);
+    auto status = XML_Parse(parser, reinterpret_cast<const char*>(decoded.bytes.data()),
+                            static_cast<int>(decoded.bytes.size()), XML_TRUE);
+    if (status != XML_STATUS_OK)
+        error(output, "metadata stream is not well-formed XML");
+    XML_ParserFree(parser);
+}
+
+inline void embedded_file(ArlPDFStream* stream, ArlPDFDictionary* attributes, std::ostream& output) {
+    Owned subtype(attributes->get_value(L"Subtype"));
+    if (kind(subtype.get(), PDFObjectType::ArlPDFObjTypeName)
+            && !mime_name(static_cast<ArlPDFName*>(subtype.get())->get_value()))
+        error(output, "embedded file Subtype is not a MIME media type or prefixed name");
+    Owned params(attributes->get_value(L"Params"));
+    if (dictionary(params.get()) == nullptr)
+        return;
+    Owned size(dictionary(params.get())->get_value(L"Size"));
+    Owned checksum(dictionary(params.get())->get_value(L"CheckSum"));
+    if (size == nullptr && checksum == nullptr)
+        return;
+    auto decoded = stream->decoded_content();
+    if (kind(size.get(), PDFObjectType::ArlPDFObjTypeNumber)
+            && static_cast<ArlPDFNumber*>(size.get())->is_integer_value()
+            && integer(size.get()) != decoded.bytes.size())
+        error(output, "embedded file Size does not match decoded bytes");
+    if (kind(checksum.get(), PDFObjectType::ArlPDFObjTypeString)) {
+        auto expected = static_cast<ArlPDFString*>(checksum.get())->get_value();
+        if (expected.size() == 16) {
+            for (size_t index = 0; index < 16; ++index) {
+                if (static_cast<unsigned char>(expected[index]) != decoded.md5[index]) {
+                    error(output, "embedded file CheckSum does not match decoded bytes");
+                    break;
+                }
+            }
+        }
+    }
+}
+#endif
+
+inline void destination_keys(ArlPDFDictionary* node, std::set<std::string>& seen, std::set<std::wstring>& keys) {
+    if (node == nullptr || !seen.insert(node->get_hash_id()).second)
+        return;
+    Owned names(node->get_value(L"Names"));
+    if (kind(names.get(), PDFObjectType::ArlPDFObjTypeArray)) {
+        auto array = static_cast<ArlPDFArray*>(names.get());
+        for (int index = 0; index + 1 < array->get_num_elements(); index += 2) {
+            Owned key(array->get_value(index));
+            if (kind(key.get(), PDFObjectType::ArlPDFObjTypeString))
+                keys.insert(static_cast<ArlPDFString*>(key.get())->get_value());
+        }
+    }
+    Owned kids(node->get_value(L"Kids"));
+    if (kind(kids.get(), PDFObjectType::ArlPDFObjTypeArray)) {
+        auto array = static_cast<ArlPDFArray*>(kids.get());
+        for (int index = 0; index < array->get_num_elements(); ++index) {
+            Owned child(array->get_value(index));
+            destination_keys(dictionary(child.get()), seen, keys);
+        }
+    }
+}
+
+class OutlineHierarchy {
+    std::ostream& output;
+    std::set<std::string> visited;
+    std::set<std::wstring> string_targets, name_targets;
+
+    // Returns the count of visible siblings and their open descendants.
+    double level(ArlPDFDictionary* parent, bool root) {
+        Owned first(parent->get_value(L"First"));
+        Owned last(parent->get_value(L"Last"));
+        Owned count(parent->get_value(L"Count"));
+        if (first == nullptr && (last != nullptr || integer(count.get()) != 0))
+            error(output, "outline First is required for a nonempty hierarchy");
+        if (last == nullptr && first != nullptr)
+            error(output, "outline Last is required for a nonempty hierarchy");
+        if (dictionary(first.get()) == nullptr)
+            return 0;
+        double visible = 0;
+        std::string previous;
+        Owned current(std::move(first));
+        while (dictionary(current.get()) != nullptr) {
+            auto node = dictionary(current.get());
+            std::string identity = node->get_hash_id();
+            if (!visited.insert(identity).second) {
+                error(output, "outline contains a cycle or repeated item");
+                break;
+            }
+            Owned declared_parent(node->get_value(L"Parent"));
+            if (dictionary(declared_parent.get()) != nullptr && declared_parent->get_hash_id() != parent->get_hash_id())
+                error(output, "outline Parent does not identify the actual parent");
+            Owned prev(node->get_value(L"Prev"));
+            if (!previous.empty() && prev == nullptr)
+                error(output, "outline Prev is required after the first sibling");
+            else if (dictionary(prev.get()) != nullptr && prev->get_hash_id() != previous)
+                error(output, "outline Prev does not identify the previous sibling");
+            Owned destination(node->get_value(L"Dest"));
+            if (kind(destination.get(), PDFObjectType::ArlPDFObjTypeString)
+                    && string_targets.count(static_cast<ArlPDFString*>(destination.get())->get_value()) == 0)
+                error(output, "outline named destination does not resolve");
+            if (kind(destination.get(), PDFObjectType::ArlPDFObjTypeName)
+                    && name_targets.count(static_cast<ArlPDFName*>(destination.get())->get_value()) == 0)
+                error(output, "outline named destination does not resolve");
+            double descendants = level(node, false);
+            Owned child_count(node->get_value(L"Count"));
+            visible += 1 + (integer(child_count.get()) > 0 ? descendants : 0);
+            previous = identity;
+            current.reset(node->get_value(L"Next"));
+        }
+        if (dictionary(last.get()) != nullptr && last->get_hash_id() != previous)
+            error(output, "outline Last does not identify the last sibling");
+        if (count == nullptr && visible > 0)
+            error(output, "outline Count is required for visible descendants");
+        else if (kind(count.get(), PDFObjectType::ArlPDFObjTypeNumber)
+                && static_cast<ArlPDFNumber*>(count.get())->is_integer_value()
+                && (root ? integer(count.get()) : std::fabs(integer(count.get()))) != visible)
+            error(output, "outline Count does not match visible descendants");
+        return visible;
+    }
+
+public:
+    explicit OutlineHierarchy(std::ostream& stream) : output(stream) {}
+
+    void check(ArlPDFDictionary* catalog) {
+        Owned names(catalog->get_value(L"Names"));
+        if (dictionary(names.get()) != nullptr) {
+            Owned tree(dictionary(names.get())->get_value(L"Dests"));
+            std::set<std::string> seen;
+            destination_keys(dictionary(tree.get()), seen, string_targets);
+        }
+        Owned legacy(catalog->get_value(L"Dests"));
+        if (dictionary(legacy.get()) != nullptr) {
+            auto values = dictionary(legacy.get());
+            for (int index = 0; index < values->get_num_keys(); ++index)
+                name_targets.insert(values->get_key_name_by_index(index));
+        }
+        Owned outline(catalog->get_value(L"Outlines"));
+        if (dictionary(outline.get()) != nullptr)
+            level(dictionary(outline.get()), true);
+    }
+};
+}
+#endif
