+// SPDX-License-Identifier: Apache-2.0
+// Original ISO 32000 annotation graph predicates for the qualified T12 checker.
+// This independent SDK observation never calls Folio or reads expected products.
+#ifndef FOLIO_ANNOTATION_CHECKS_H
+#define FOLIO_ANNOTATION_CHECKS_H
+
+#include "FolioMetadataChecks.h"
+
+namespace folio_annotation {
+using namespace ArlingtonPDFShim;
+using folio_metadata::Owned;
+using folio_metadata::dictionary;
+using folio_metadata::error;
+using folio_metadata::kind;
+
+inline bool present(ArlPDFObject* object) {
+    // ISO 32000 7.3.9: a dictionary entry whose value is null is absent.
+    return object != nullptr && object->get_object_type() != PDFObjectType::ArlPDFObjTypeNull;
+}
+
+inline void page(ArlPDFDictionary* page, std::ostream& output) {
+    Owned annotations(page->get_value(L"Annots"));
+    if (!kind(annotations.get(), PDFObjectType::ArlPDFObjTypeArray))
+        return; // The ordinary model reports malformed Annots values.
+    auto array = static_cast<ArlPDFArray*>(annotations.get());
+    std::set<std::wstring> names;
+    for (int index = 0; index < array->get_num_elements(); ++index) {
+        Owned item(array->get_value(index));
+        auto annotation = dictionary(item.get());
+        if (annotation == nullptr)
+            continue;
+        // ISO 32000-2:2020 Table 166 requires uniqueness within the containing page.
+        Owned name(annotation->get_value(L"NM"));
+        if (kind(name.get(), PDFObjectType::ArlPDFObjTypeString)) {
+            if (!names.insert(static_cast<ArlPDFString*>(name.get())->get_value()).second)
+                error(output, "annotation NM is duplicated within its page");
+        }
+        // Table 166: an optional indirect P identifies this containing page.
+        Owned owner(annotation->get_value(L"P"));
+        if (present(owner.get()) && owner->is_indirect_ref()
+                && owner->get_hash_id() != page->get_hash_id())
+            error(output, "annotation P does not identify its containing page");
+    }
+}
+
+inline void link(ArlPDFDictionary* annotation, std::ostream& output) {
+    // ISO 32000-2:2020 Table 176: either binding is optional; both cannot be present.
+    Owned destination(annotation->get_value(L"Dest"));
+    Owned action(annotation->get_value(L"A"));
+    if (present(destination.get()) && present(action.get()))
+        error(output, "Link annotation Dest and A are mutually exclusive");
+}
+}
+#endif
