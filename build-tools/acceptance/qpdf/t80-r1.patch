+                        }
+                        auto ef = object.getKey("/EF");
+                        if (!ef.isDictionary()) {
+                            continue;
+                        }
+                        for (auto const& entry: ef.getDictAsMap()) {
+                            if (entry.second.isStream() && entry.second.getObjGen() == og) {
