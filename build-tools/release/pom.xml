<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>net.zerocloud</groupId>
    <artifactId>pdf-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>pdf-release-tool</artifactId>
  <packaging>jar</packaging>

  <name>Folio PDF by ZeroCloud - Release Rehearsal Tool</name>
  <description>Repository-only structural validation for non-publishing release rehearsals.</description>

  <properties>
    <release.command>validate</release.command>
    <release.output>${maven.multiModuleProjectDirectory}/target/release-rehearsal</release.output>
    <release.bundle.output>${release.output}/central-bundle.zip</release.bundle.output>
    <release.repository.root>${maven.multiModuleProjectDirectory}</release.repository.root>
    <release.version>0.1.0</release.version>
    <maven.install.skip>true</maven.install.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <repositoryRoot>${maven.multiModuleProjectDirectory}</repositoryRoot>
            <releaseToolClasspath>${project.build.outputDirectory}</releaseToolClasspath>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <mainClass>net.zerocloud.pdf.tools.release.ReleaseBundleCommand</mainClass>
          <classpathScope>runtime</classpathScope>
          <arguments>
            <argument>${release.command}</argument>
            <argument>${release.output}</argument>
            <argument>${release.bundle.output}</argument>
            <argument>${release.repository.root}</argument>
            <argument>${release.version}</argument>
          </arguments>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
