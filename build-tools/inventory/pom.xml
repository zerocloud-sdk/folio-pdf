<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>net.zerocloud</groupId>
    <artifactId>pdf-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>pdf-inventory-tool</artifactId>
  <packaging>jar</packaging>

  <name>Folio PDF by ZeroCloud - Inventory Build Tool</name>
  <description>Repository-only validation and documentation generation for compatibility inventories.</description>

  <properties>
    <inventory.action>validate</inventory.action>
    <inventory.repository.root>${maven.multiModuleProjectDirectory}</inventory.repository.root>
    <maven.install.skip>true</maven.install.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>${snakeyaml.version}</version>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <repositoryRoot>${maven.multiModuleProjectDirectory}</repositoryRoot>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <mainClass>net.zerocloud.pdf.tools.inventory.InventoryCommand</mainClass>
          <classpathScope>runtime</classpathScope>
          <arguments>
            <argument>${inventory.action}</argument>
            <argument>${inventory.repository.root}</argument>
          </arguments>
        </configuration>
        <executions>
          <execution>
            <id>check-compatibility-inventories</id>
            <phase>verify</phase>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <arguments combine.self="override">
                <argument>check</argument>
                <argument>${maven.multiModuleProjectDirectory}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
