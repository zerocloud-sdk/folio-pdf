#!/usr/bin/env sh
set -eu

script_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repository_root=$(CDPATH= cd -- "${script_directory}/../.." && pwd)

. "${script_directory}/../imagemagick-pin.properties"
. "${script_directory}/../visual-tool-common"
imagemagick_version=${IMAGEMAGICK_VERSION}
archive_sha256=${IMAGEMAGICK_ARCHIVE_SHA256}
executable_sha256=${IMAGEMAGICK_EXECUTABLE_SHA256}
imagemagick_cache=${IMAGEMAGICK_CACHE_DIRECTORY:-"${repository_root}/.build-cache/imagemagick"}
sha256_command=${SHA256_COMMAND:-sha256sum}
imagemagick_home=${imagemagick_cache}/${imagemagick_version}
imagemagick_executable=${imagemagick_home}/bin/imagemagick.AppImage

if [ ! -x "${imagemagick_executable}" ]; then
    echo "Pinned ImageMagick ${imagemagick_version} is not provisioned; run ./scripts/provision-imagemagick." >&2
    exit 127
fi
if ! visual_verify_marker \
        "Pinned ImageMagick" \
        "${imagemagick_home}/.archive-sha256" \
        "${archive_sha256}" \
        || ! visual_verify_marker \
            "Pinned ImageMagick" \
            "${imagemagick_home}/.executable-sha256" \
            "${executable_sha256}" \
        || ! visual_verify_digest \
            "Pinned ImageMagick executable" \
            "${imagemagick_executable}" \
            "${executable_sha256}" \
            "${sha256_command}"; then
    exit 127
fi

imagemagick_runtime=${IMAGEMAGICK_RUNTIME_DIRECTORY:-"${imagemagick_home}/runtime"}
if [ -n "${IMAGEMAGICK_RUNTIME_DIRECTORY:-}" ] || [ -d "${imagemagick_runtime}" ]; then
    runtime_expected_count=0
    while read -r runtime_sha256 runtime_name; do
        if ! visual_verify_digest \
                "Pinned ImageMagick private runtime" \
                "${imagemagick_runtime}/${runtime_name}" \
                "${runtime_sha256}" \
                "${sha256_command}"; then
            exit 127
        fi
        runtime_expected_count=$((runtime_expected_count + 1))
    done < "${script_directory}/../imagemagick-runtime.sha256"
    runtime_actual_count=0
    for runtime_entry in "${imagemagick_runtime}"/* "${imagemagick_runtime}"/.[!.]* "${imagemagick_runtime}"/..?*; do
        if [ -e "${runtime_entry}" ] || [ -L "${runtime_entry}" ]; then
            runtime_actual_count=$((runtime_actual_count + 1))
        fi
    done
    if [ "${runtime_actual_count}" -ne "${runtime_expected_count}" ]; then
        echo "Pinned ImageMagick private runtime contains undeclared entries." >&2
        exit 127
    fi
    LD_LIBRARY_PATH="${imagemagick_runtime}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
    export LD_LIBRARY_PATH
fi

APPIMAGE_EXTRACT_AND_RUN=1
export APPIMAGE_EXTRACT_AND_RUN
exec "${imagemagick_executable}" "$@"
