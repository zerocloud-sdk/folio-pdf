#!/usr/bin/env sh
set -eu

script_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repository_root=$(CDPATH= cd -- "${script_directory}/../.." && pwd)

. "${script_directory}/../pdfium-pin.properties"
. "${script_directory}/../visual-tool-common"
pdfium_cli_version=${PDFIUM_CLI_VERSION}
pdfium_engine_version=${PDFIUM_ENGINE_VERSION}
archive_sha256=${PDFIUM_ARCHIVE_SHA256}
executable_sha256=${PDFIUM_EXECUTABLE_SHA256}
pdfium_cache=${PDFIUM_CACHE_DIRECTORY:-"${repository_root}/.build-cache/pdfium"}
sha256_command=${SHA256_COMMAND:-sha256sum}
pdfium_home=${pdfium_cache}/${pdfium_cli_version}-${pdfium_engine_version}
pdfium_executable=${pdfium_home}/bin/pdfium

if [ ! -x "${pdfium_executable}" ]; then
    echo "Pinned PDFium ${pdfium_cli_version} (${pdfium_engine_version}) is not provisioned; run ./scripts/provision-pdfium." >&2
    exit 127
fi
if ! visual_verify_marker \
        "Pinned PDFium" "${pdfium_home}/.archive-sha256" "${archive_sha256}" \
        || ! visual_verify_marker \
            "Pinned PDFium" \
            "${pdfium_home}/.executable-sha256" \
            "${executable_sha256}" \
        || ! visual_verify_marker \
            "Pinned PDFium" "${pdfium_home}/.engine-version" \
            "${pdfium_engine_version}" \
        || ! visual_verify_digest \
            "Pinned PDFium executable" \
            "${pdfium_executable}" \
            "${executable_sha256}" \
            "${sha256_command}"; then
    exit 127
fi

exec "${pdfium_executable}" "$@"
