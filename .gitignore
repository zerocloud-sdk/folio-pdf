# Maven build output
target/
**/target/

# Repository-owned local validation caches
.build-cache/
__pycache__/

# IDE and editor state
.idea/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/
.vscode/
*~

# Operating-system and diagnostic files
.DS_Store
Thumbs.db
*.log
# T71 observer output is retained certification evidence.
!/capabilities/evidence/foundation/T71-*/**/observer.log
# T74 observer and safety-probe output is retained certification evidence.
!/capabilities/evidence/foundation/T74-*/**/observer.log
!/capabilities/evidence/foundation/T74-*/**/child.log
# T76 environment and refreshed predecessor logs are retained certification evidence.
!/capabilities/evidence/foundation/T76-*/**/*.log
# T77 incremental certification and refreshed predecessor logs are retained certification evidence.
!/capabilities/evidence/T77-*/**/*.log
# T78 password-baseline certification and refreshed predecessor logs are retained certification evidence.
!/capabilities/evidence/foundation/T78-*/**/*.log
!/capabilities/evidence/T78-*/**/*.log
# T79 password clear-metadata certification and refreshed predecessor logs are retained certification evidence.
!/capabilities/evidence/foundation/T79-*/**/*.log
!/capabilities/evidence/T79-*/**/*.log
# T80 password embedded-files-only certification and refreshed predecessor logs are retained certification evidence.
!/capabilities/evidence/foundation/T80-*/**/*.log
!/capabilities/evidence/T80-*/**/*.log
# T81 hostile-input certification and refreshed predecessor logs are retained evidence.
!/capabilities/evidence/foundation/T81-*/**/*.log
!/capabilities/evidence/T81-*/**/*.log
# T82 Worker certification and current predecessor observer logs are retained evidence.
!/capabilities/evidence/foundation/T82-*/**/*.log
!/capabilities/evidence/T82-*/**/*.log
# T81 publishes only the final-r2 certification and curated delivery records; superseded attempts and candidate payloads stay local.
/capabilities/evidence/foundation/T81-initial/
/capabilities/evidence/foundation/T81-final/
/capabilities/evidence/T81-delivery/initial-candidate/originals/
/capabilities/evidence/T81-delivery/initial-candidate-r7/originals/
/capabilities/evidence/T81-delivery/initial-candidate-r7/*.zip
/capabilities/evidence/T81-delivery/final-candidate/originals/
/capabilities/evidence/T81-delivery/final-candidate/*.zip
# T82 publishes only the indexed final certification (+ T82-final-r2 password-attachments continuation) and curated delivery; superseded development trees and obsolete candidate payloads stay local.
/capabilities/evidence/foundation/T82-development-r1/
/capabilities/evidence/foundation/T82-development-r2/
/capabilities/evidence/foundation/T82-development-jdk8-r1/
/capabilities/evidence/foundation/T82-development-jdk8-r2/
/capabilities/evidence/foundation/T82-development-jdk8-r3/
/capabilities/evidence/T82-delivery/candidate-final-r1/*.zip
/capabilities/evidence/T82-delivery/candidate-final-r1/*.zip.part*
/capabilities/evidence/T82-delivery/candidate-source-freeze-r1/*.zip
/capabilities/evidence/T82-delivery/candidate-source-freeze-r1/*.zip.part*
/capabilities/evidence/T82-delivery/development-candidate-r2/*.zip
/capabilities/evidence/T82-delivery/development-candidate-r2/*.zip.part*
/capabilities/evidence/T82-delivery/development-candidate-r3/*.zip
/capabilities/evidence/T82-delivery/development-candidate-r3/*.zip.part*
hs_err_pid*
replay_pid*
