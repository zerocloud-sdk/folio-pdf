                <configuration>
                  <mainClass>net.zerocloud.pdf.acceptance.T25ParagraphEvidenceCommand</mainClass>
                  <classpathScope>runtime</classpathScope>
                  <arguments>
                    <argument>${acceptance.output}</argument>
