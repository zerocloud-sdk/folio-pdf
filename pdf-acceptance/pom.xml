<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>net.zerocloud</groupId>
    <artifactId>pdf-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>pdf-acceptance</artifactId>
  <packaging>jar</packaging>

  <name>Folio PDF by ZeroCloud - Acceptance Evidence</name>
  <description>Repository-only independent Acceptance Evidence pipeline.</description>

  <properties>
    <maven.install.skip>true</maven.install.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
    <t30.qpdf.pin>${maven.multiModuleProjectDirectory}/scripts/qpdf-pin.properties</t30.qpdf.pin>
    <t30.pdfium.pin>${maven.multiModuleProjectDirectory}/scripts/pdfium-pin.properties</t30.pdfium.pin>
    <t30.imagemagick.pin>${maven.multiModuleProjectDirectory}/scripts/imagemagick-pin.properties</t30.imagemagick.pin>
    <t31.qpdf.pin>${maven.multiModuleProjectDirectory}/scripts/qpdf-pin.properties</t31.qpdf.pin>
    <t31.pdfium.pin>${maven.multiModuleProjectDirectory}/scripts/pdfium-pin.properties</t31.pdfium.pin>
    <t31.imagemagick.pin>${maven.multiModuleProjectDirectory}/scripts/imagemagick-pin.properties</t31.imagemagick.pin>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.google.zxing</groupId>
      <artifactId>core</artifactId>
      <version>${zxing.version}</version>
    </dependency>
    <dependency>
      <groupId>net.zerocloud</groupId>
      <artifactId>pdf-document</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>${pdfbox.version}</version>
    </dependency>
    <dependency>
      <groupId>net.zerocloud</groupId>
      <artifactId>pdf-conversion</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-tiff</artifactId>
      <version>${twelvemonkeys.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <repositoryRoot>${maven.multiModuleProjectDirectory}</repositoryRoot>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>acceptance-t31-record</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>record-two-dimensional-barcode-evidence</id>
                <phase>verify</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>${java.home}/bin/java</executable>
                  <classpathScope>runtime</classpathScope>
                  <arguments>
                    <argument>-Xmx1024m</argument>
                    <argument>-classpath</argument>
                    <classpath/>
                    <argument>net.zerocloud.pdf.acceptance.T31BarcodeEvidenceCommand</argument>
                    <argument>${acceptance.output}</argument>
                    <argument>${t31.qpdf.pin}</argument>
                    <argument>${t31.pdfium.pin}</argument>
                    <argument>${t31.imagemagick.pin}</argument>
                    <argument>${maven.multiModuleProjectDirectory}/capabilities/profiles</argument>
                    <argument>${project.version}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>acceptance-t30-record</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>record-one-dimensional-barcode-evidence</id>
                <phase>verify</phase>
                <goals><goal>java</goal></goals>
                <configuration>
                  <mainClass>net.zerocloud.pdf.acceptance.T30BarcodeEvidenceCommand</mainClass>
                  <classpathScope>runtime</classpathScope>
                  <arguments>
                    <argument>${acceptance.output}</argument>
                    <argument>${t30.qpdf.pin}</argument>
                    <argument>${t30.pdfium.pin}</argument>
                    <argument>${t30.imagemagick.pin}</argument>
                    <argument>${maven.multiModuleProjectDirectory}/capabilities/profiles</argument>
                    <argument>${project.version}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>acceptance-t29-record</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>record-shaping-evidence</id>
                <phase>verify</phase>
                <goals><goal>java</goal></goals>
                <configuration>
                  <mainClass>net.zerocloud.pdf.acceptance.T29ShapingEvidenceCommand</mainClass>
                  <classpathScope>runtime</classpathScope>
                  <arguments>
                    <argument>${acceptance.output}</argument>
                    <argument>${maven.multiModuleProjectDirectory}/scripts/qpdf-pin.properties</argument>
                    <argument>${maven.multiModuleProjectDirectory}/scripts/pdfium-pin.properties</argument>
                    <argument>${maven.multiModuleProjectDirectory}/scripts/imagemagick-pin.properties</argument>
                    <argument>${maven.multiModuleProjectDirectory}/capabilities/profiles</argument>
                    <argument>${project.version}</argument>
                    <argument>${folio.harfBuzzHelper}</argument>
                    <argument>${env.FOLIO_SHAPING_PYTHON}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>acceptance-record</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
