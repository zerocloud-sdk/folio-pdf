                    <argument>${t30.imagemagick.pin}</argument>
                    <argument>${maven.multiModuleProjectDirectory}/capabilities/profiles</argument>
                    <argument>${project.version}</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>record-two-dimensional-barcode-evidence</id>
                <phase>verify</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>${java.home}/bin/java</executable>
                  <classpathScope>runtime</classpathScope>
                  <arguments>
                    <argument>-Xmx1024m</argument>
                    <argument>-classpath</argument>
                    <classpath/>
                    <argument>net.zerocloud.pdf.acceptance.T31BarcodeEvidenceCommand</argument>
                    <argument>${acceptance.output}</argument>
