                  <arguments>
                    <argument>${acceptance.output}</argument>
                    <argument>${maven.multiModuleProjectDirectory}/scripts/qpdf-pin.properties</argument>
                    <argument>${maven.multiModuleProjectDirectory}/scripts/pdfium-pin.properties</argument>
                    <argument>${maven.multiModuleProjectDirectory}/scripts/imagemagick-pin.properties</argument>
                    <argument>${maven.multiModuleProjectDirectory}/capabilities/profiles/T03-document-blank-visual.properties</argument>
                    <argument>${maven.multiModuleProjectDirectory}/capabilities/profiles/T18-canvas-images-colors-transparency-visual.properties</argument>
                    <argument>${maven.multiModuleProjectDirectory}/capabilities/profiles/T19-font-loading-embedding-subsetting-visual.properties</argument>
                    <argument>${project.version}</argument>
                  </arguments>
